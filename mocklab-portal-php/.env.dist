# Copy this file to .env and fill in the values. Never commit .env.
# Format: KEY=value (one per line, lines starting with # are comments).
# Labplus integration (preinterpretation and LabTest Checker). The LABPLUS_* values are provided by Labplus.
# Without them the portal still works, only the integration is switched off.

# Partner ID (clientHash), sent in the X-Client-Hash header of every request.
LABPLUS_CLIENT_HASH=
# Secret key (appKey), only used to sign requests and never sent anywhere. Keep it secret.
LABPLUS_APP_KEY=

# Addresses of the Labplus services, each one full and separate, so a service can be moved to another host
# by changing only its line. No trailing slash.
# Platform token (the order's results are sent here once, the token is used by both services),
# e.g. https://api.example.com/v1/token
LABPLUS_TOKEN_URL=
# Preinterpretation (POST starts it, GET returns the result), e.g. https://api.example.com/v1/preinterpretation
LABPLUS_PRE_URL=
# LabTest Checker API, e.g. https://api.example.com/v1/ltc
# (the code adds /interpretation, /re-entry and /interview-status).
LABPLUS_LTC_API_URL=
# LabTest Checker page shown in the iframe, host only, e.g. https://ltc.example.com
# (the code adds /interview/...).
LABPLUS_LTC_IFRAME_URL=

# Any long random string of your own (not from Labplus), keep it constant: the patientHash sent to Labplus is
# HMAC-SHA256(PATIENT_HASH_SECRET, national ID), because a plain SHA-256 of a national ID can be reversed by brute force.
PATIENT_HASH_SECRET=
