<%- include('partials/header') %>

<% if (flash) { %>
    <div class="notice"><%= flash %></div>
<% } %>

<div class="card info-card">
    <div><span class="label">Patient</span><%= patient.firstName %> <%= patient.lastName %></div>
    <div><span class="label">Gender, age</span><%= patientText() %></div>
    <div><span class="label">Date of birth</span><%= patient.birthDate %></div>
    <div><span class="label">National ID</span><%= patient.nationalId %></div>
</div>

<div class="eyebrow eyebrow-line">Orders</div>
<h2 class="section-title">Your orders</h2>
<p class="muted">All tests done for you at MockLab.</p>

<%# demo only %>
<%- include('partials/demo_box') %>

<div class="grid">
    <% for (const order of orders) { const outOfRange = countOutOfRange(order); %>
        <a class="card order-card" href="/orders/<%= order.id %>">
            <span class="num-badge"><%= String(order.id).padStart(2, '0') %></span>
            <h3><%= orderTitle(order) %></h3>
            <p class="muted"><%= order.number %> &middot; <%= order.date %></p>
            <div class="tags">
                <span class="pill pill-grey"><%= orderParams(order).length %> results</span>
                <% if (outOfRange) { %>
                    <span class="pill pill-alert"><%= outOfRange %> out of range</span>
                <% } else { %>
                    <span class="pill pill-mint">All in range</span>
                <% } %>
            </div>
        </a>
    <% } %>
</div>

<%- include('partials/footer') %>
